# Copy to .env (untracked). Every variable is read in app/config.py.

# Value clients send in X-Demo-Key. Use a long random string in production.
DEMO_API_KEY=dev-key

# Separate browser login code. Set privately in Railway; blank disables web login.
WEB_LOGIN_CODE=
# Opaque browser cookie lifetime (seconds); sessions reset on server restart.
WEB_SESSION_TTL_S=14400

# memory | supabase
STORAGE=memory

# Local file root for the memory store
DATA_DIR=.data

# Required when STORAGE=supabase (BE-02)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Read by echo_ai: 1 = fake AI, 0 = real Gemini
ECHO_AI_FAKE=1
# Required when ECHO_AI_FAKE=0 (read by echo_ai)
GEMINI_API_KEY=

# ElevenLabs voice for GET /tts-token (API-CONTRACT §5.4). Backend only, never read by echo_ai.
# Blank key or voice id = /tts-token answers 503 and the app falls back to on-device speech.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Blank = eleven_flash_v2_5
ELEVENLABS_MODEL=

# Model time budgets in seconds (API-CONTRACT §3)
CHECK_BUDGET_S=8
WATCH_BUDGET_S=3.5

# Signed URL lifetime in seconds
SIGNED_URL_TTL_S=7200

# Video size limit in MiB; must not exceed Supabase's global upload limit (50 MiB on Free)
MAX_VIDEO_MB=50

# Comma-separated origins; restrict in production
CORS_ORIGINS=*

# Static web app, mounted at /app/ when the directory exists
WEB_DIR=../web

# Used to build local file URLs in memory mode; empty = derived from the request
PUBLIC_BASE_URL=

# Failure rehearsal (BE-07.2). Leave both unset in production: with FAULT_INJECT_ENABLED=1 and a
# FAULT_INJECT value, any request carrying the header `X-Fault: 1` fails like the model did.
# FAULT_INJECT=timeout          # timeout | quota | unavailable
# FAULT_INJECT_ENABLED=1
